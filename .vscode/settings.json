{
  // Автоматически форматировать код при любом сохранении (включая автосохранение!)
  "editor.formatOnSave": true,

  // Использовать встроенный форматировщик для JS/TS (он уже есть в VSCode)
  "editor.defaultFormatter": "vscode.typescript-language-features",

  // Размер отступа: 2 пробела (золотой стандарт для JavaScript и HTML)
  "editor.tabSize": 2,

  // При нажатии Tab вставлять пробелы, а не символ табуляции (\t)
  "editor.insertSpaces": true,

  // Автоматически удалять лишние пробелы в конце строк при сохранении
  // (Это очень важно для Git: чтобы коммиты не раздувались из-за невидимых пробелов)
  "files.trimTrailingWhitespace": true,

  // Автоматически добавлять одну пустую строку в конец файла при сохранении
  // (Требование многих стандартов кодирования и POSIX-систем)
  "files.insertFinalNewline": true,

  // Удалять конечные пустые строки, кроме одной
  "files.trimFinalNewlines": true,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
