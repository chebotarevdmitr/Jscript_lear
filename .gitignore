# ============================================
# ЗАВИСИМОСТИ
# ============================================
# Папка с установленными npm-пакетами (может весить сотни МБ)
node_modules/
jspm_packages/

# Yarn PnP (альтернативный способ хранения зависимостей)
.pnp
.pnp.js

# ============================================
# ЛОГИ И ОТЧЁТЫ
# ============================================
# Логи (важно не коммитить, т.к. могут содержать чувствительные данные)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Отчёты о покрытии тестами
coverage/
*.lcov
.nyc_output/

# ============================================
# СБОРКА И ДИСТРИБУТИВ
# ============================================
# Папки, куда сборщики (webpack, vite, parcel) кладут результат
dist/
build/
.output/
.parcel-cache/

# Кэш сборщиков
.cache/
.eslintcache/
.stylelintcache/

# Next.js / Nuxt (если будешь изучать фреймворки)
.next/
.nuxt/
out/

# ============================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ============================================
# Файлы с секретами (токены, пароли, API-ключи)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ============================================
# РЕДАКТОРЫ И IDE
# ============================================
# VSCode (только специфичные пользовательские файлы)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# WebStorm / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.#*

# ============================================
# ОПЕРАЦИОННАЯ СИСТЕМА
# ============================================
# macOS
.DS_Store
.AppleDouble
.Spotlight-V100
.Trashes
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ============================================
# ВРЕМЕННЫЕ ФАЙЛЫ И ЧЕРНОВИКИ
# ============================================
*.tmp
*.temp
*.bak
*.backup
*.old

# Личные заметки и черновики (не для репозитория)
drafts/
scratch/
temp/
TODO-personal.md

# ============================================
# СЕРВЕРЫ И БАЗЫ ДАННЫХ
# ============================================
# Локальные серверы
*.pid
*.seed
*.pid.lock

# SQLite
*.sqlite
*.sqlite3

# ============================================
# ВАЖНО: НЕ ИГНОРИРУЕМ
# ============================================
# Эти файлы НУЖНО коммитить, поэтому они НЕ в .gitignore:
# - package-lock.json (или yarn.lock, pnpm-lock.yaml)
# - tsconfig.json
# - .eslintrc, .prettierrc
# - Все исходники (.js, .html, .css, .ts)